                "content": "function main(params) {\n  const outputList = params.outputList;\n  if (outputList?.length === 0 || !params.input) {\n    return {\n      result: {\n        taskId: params.taskId,\n        techInfo: \"\"\n      },\n    }\n  }\n\n  const convertOutput = convertToJson(params.input);\n\n  return {\n    result: {\n      taskId: params.taskId,\n      techInfo: convertOutput\n    },\n  }\n}\n\nfunction convertToJson(inputString) {\n  try {\n    //   // 首先尝试直接解析，如果已经是有效的JSON格式\n    return JSON.parse(inputString);\n  } catch (e) {\n    // 提取JSON部分\n    const jsonStart = inputString.indexOf('[');\n    const jsonEnd = inputString.lastIndexOf(']') + 1;\n    const jsonStr = inputString.substring(jsonStart, jsonEnd);\n\n\n    // 如果不是有效的JSON，进行手动转换\n    // 移除开头的 [\\n 和结尾的 ]，然后按对象分割\n    const cleanedString = jsonStr.trim()\n    //   .replace(/^\\\\[\\s\\\\n]*/, '')\n    //   .replace(/[\\s\\\\n]*\\\\]$/, '');\n\n    if (cleanedString.trim() === '') return '';\n\n\n    console.log(jsonStr);\n    try {\n      // console.log(cleanedString.trim());\n\n      // 1. 清理非字符串内部的字面量 '\\n', '\\r', '\\t'\n      // 正则解释：\n      // \"(?:\\\\\\\\|\\\\\"|[^\"])*\" 匹配标准的 JSON 字符串（处理了内部转义的引号）\n      // \\\\\\\\ 匹配外部连续的两个反斜杠（防止破坏正常的转义）\n      // \\\\[nrt] 匹配字面量的 \\n, \\r, \\t\n      let preprocessed = cleanedString.trim().replace(/\"(?:\\\\\\\\|\\\\\"|[^\"])*\"|\\\\\\\\|\\\\[nrt]/g, (match) => {\n        if (match === '\\\\n' || match === '\\\\r' || match === '\\\\t') {\n          // 如果是非字符串内部的字面量换行/制表符，直接移除\n          return '';\n        }\n        // 如果是完整的字符串内容，原样保留，不破坏字符串内部的 \\n\n        return match;\n      });\n\n      // 2. 去除可能包含的 markdown 代码块包裹 (例如 ```json 和 ```)\n      preprocessed = preprocessed\n        .replace(/^[\\s\\n]*```[a-z]*[\\s\\n]*/i, '') // 移除开头的 ```json 及其前后空白\n        .replace(/[\\s\\n]*```[\\s\\n]*$/i, '')       // 移除结尾的 ``` 及其前后空白\n        .trim();\n\n      // 解析为JSON对象\n      const obj = JSON.parse(cleanedString);\n      return obj\n    } catch (parseError) {\n      try {\n        const obj = safeParseJSON(cleanedString);\n        return obj\n      } catch (e) {\n        console.warn('解析对象时出错:', parseError);\n        // 如果解析失败，尝试手动构建对象\n        const manualObj = {};\n        const repositoryIdMatch = cleanedString.match(/\"warehouseCodingId\":\\s*\"([^\"]*)\"/);\n        const outputMatch = cleanedString.match(/\"output\":\\s*\"([\\s\\S]*?)(?=\",\\s*\"|}$)/);\n        const repositoryNameMatch = cleanedString.match(/\"warehouseName\":\\s*\"([^\"]*)\"/);\n\n        if (repositoryIdMatch) {\n          manualObj.warehouseCodingId = repositoryIdMatch[1];\n        }\n        if (outputMatch) {\n          manualObj.output = outputMatch[1].replace(/\\\\n/g, '\\n').replace(/\\\\\"/g, '\"');\n        }\n        if (repositoryNameMatch) {\n          manualObj.warehouseName = repositoryNameMatch[1];\n        }\n\n        return manualObj;\n\n\n      }\n    }\n  }\n}\n\n/**\n * 修复 JSON 字符串中 output 字段内未转义的双引号\n * @param {string} jsonStr - 包含未转义引号的 JSON 字符串\n * @returns {string} 修复后可正常解析的 JSON 字符串\n */\nfunction fixOutputFieldQuotes(jsonStr) {\n  // 匹配 \"output\": \" 之后的内容，直到字段值结束\n  const outputKeyRegex = /\"output\"\\s*:\\s*\"/;\n  const match = jsonStr.match(outputKeyRegex);\n\n  if (!match) return jsonStr;\n\n  // 定位 output 值起始位置（引号之后）\n  const valueStartIndex = match.index + match[0].length;\n  const beforeValue = jsonStr.substring(0, valueStartIndex);\n  const remaining = jsonStr.substring(valueStartIndex);\n\n  // 从后往前找字段值的结束引号\n  // 结束引号特征：后面紧跟 \\s*[}\\],] 或字符串末尾\n  const endQuoteRegex = /\"(\\s*[}\\],]|$)/g;\n  let lastValidEnd = -1;\n  let execResult;\n\n  // 找到所有可能的结束引号位置，取最后一个\n  while ((execResult = endQuoteRegex.exec(remaining)) !== null) {\n    lastValidEnd = execResult.index;\n  }\n\n  if (lastValidEnd === -1) return jsonStr;\n\n  // 提取字段值内容（不含首尾引号）\n  const valueContent = remaining.substring(0, lastValidEnd);\n  const afterValue = remaining.substring(lastValidEnd);\n\n  // 对内容中的双引号进行转义（已转义的 \\\" 不重复处理）\n  const escapedValue = valueContent.replace(/(?<!\\\\)\"/g, '\\\\\"');\n\n  return beforeValue + escapedValue + afterValue;\n}\n\n/**\n * 解析包含未转义引号的 JSON 字符串\n * @param {string} jsonStr - 原始 JSON 字符串\n * @returns {object} 解析后的 JSON 对象\n */\nfunction safeParseJSON(jsonStr) {\n  const fixed = fixOutputFieldQuotes(jsonStr);\n  return JSON.parse(fixed);\n}",
