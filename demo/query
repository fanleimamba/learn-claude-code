                            "content": "function main(params) {\n    const lines = params.content.split('\\n');\n    let inPackageImportSection = true;\n    let resultLines = [];\n\n    for (let line of lines) {\n        const trimmedLine = line.trim();\n        \n        // 跳过空行但保留在结果中\n        if (trimmedLine === '') {\n            resultLines.push(line);\n            continue;\n        }\n        \n        // 检查是否还在package/import部分\n        if (inPackageImportSection) {\n            if (trimmedLine.startsWith('package ') || trimmedLine.startsWith('import ')) {\n                continue; // 跳过package和import行\n            } else {\n                // 遇到第一个非package/import行，结束过滤\n                inPackageImportSection = false;\n                resultLines.push(line);\n            }\n        } else {\n            resultLines.push(line);\n        }\n    }\n\n    return {\n        result: resultLines.join('\\n')\n    };\n}\n",
