                "content": "function main(params) {\n  // 使用buildTree工具函数转换为可视化树结构\n  const response = params.response ? params.response : params.response2;\n  let obj = [];\n  try {\n    obj = JSON.parse(response ?? '[]');\n    // const tree = buildDirectoryTree(obj || []);\n    // const visualization = printTree(tree);\n    // const isBackend = visualization.includes('pom.xml');\n\n    const arr = obj?.map(item => item.path); // 输入数组\n    const chunkSize = Math.ceil(arr.length / 4); // 每个分块的大小\n\n    const result = [];\n    for (let i = 0; i < arr.length; i += chunkSize) {\n      result.push(arr.slice(i, i + chunkSize).join('\\n'));\n    }\n\n    // 确保总是返回4个数组，不足的用空数组填充\n    while (result.length < 4) {\n      result.push([].join('\\n'));\n    }\n\n    return {\n      output: {\n        // \"tree\": tree,\n        // \"treeContent\": visualization, // 可视化目录树结构\n        // \"skip_file\": isBackend ? \"[\\\"test/*\\\",\\\"node_modules/**/*\\\",\\\".git/**/*\\\"]\" : \"[\\\"node_modules/**/*\\\",\\\".git/**/*\\\"]\", \n        \"ref\": params.name ? params.branch : \"master\",\n        \"path\": [result[0], result[1], result[2], result[3]],\n        \"allPath\": result.join('\\n')\n      }\n    }\n  } catch (e) {\n    return {\n      output: {\n        // \"tree\": '',\n        // \"treeContent\": '', // 可视化目录树结构\n        // \"skip_file\": \"[\\\"node_modules/**/*\\\",\\\".git/**/*\\\"]\",\n        \"ref\": params.name ? params.branch : \"master\",\n        \"path\": obj?.map(item => item.path).join('\\n'),\n        \"allPath\": \"\",\n      }\n    }\n  }\n}\n\n/**\n * 将数组结构的path数据生成对应的目录树结构\n * @param files - 包含文件信息的数组，每个元素包含id, name, type, path, mode属性\n * @returns 目录树结构对象\n */\nfunction buildDirectoryTree(files) {\n  const root = {\n    name: '',\n    type: 'directory',\n    children: {}\n  };\n\n  files.forEach(file => {\n    const pathParts = file.path.split('/');\n    let current = root;\n\n    // 遍历路径的每一部分\n    pathParts.forEach((part, index) => {\n      const isLast = index === pathParts.length - 1;\n\n      if (isLast) {\n        // 最后一项，添加文件或目录\n        if (file.type === 'blob') {\n          // 文件\n          current.children[part] = {\n            type: 'file',\n            path: file.path\n          };\n        } else {\n          // 目录\n          current.children[part] = {\n            type: 'directory',\n            path: file.path,\n            children: {}\n          };\n        }\n      } else {\n        // 中间目录项\n        if (!current.children[part]) {\n          current.children[part] = {\n            name: part,\n            type: 'directory',\n            children: {}\n          };\n        }\n        current = current.children[part];\n      }\n    });\n  });\n\n  return root.children;\n}\n\n/**\n * 将目录树结构转换为可视化的字符串格式 (使用 |- 格式)\n * @param tree - 目录树对象\n * @param prefix - 前缀字符串，用于缩进\n * @param isLast - 是否为最后一个子项\n * @param maxFiles - 每个层级最多显示的文件数量，超过则显示省略号\n * @param currentPath - 当前路径\n * @returns 可视化的树结构字符串\n */\nfunction printTree(\n  tree,\n  prefix = '',\n  _isLast = true,\n  maxFiles = 20,\n  currentPath = ''\n) {\n  let result = '';\n  const entries = Object.entries(tree);\n\n  // 分离文件和目录\n  const files = [];\n  const directories = [];\n\n  entries.forEach(([name, node]) => {\n    if (node.type === 'file') {\n      files.push([name, node]);\n    } else {\n      directories.push([name, node]);\n    }\n  });\n\n  // 检查当前目录是否是需要特殊处理的目录（pages或components）\n  const isPagesDir = currentPath.endsWith('/pages') || currentPath.includes('/pages/');\n  const isComponentsDir = currentPath.endsWith('/components') || currentPath.includes('/components/');\n  const isSpecialDir = isPagesDir || isComponentsDir;\n  const maxDirs = 10; // 特殊目录最多显示的子目录数量\n\n  // 处理目录 - 特殊目录只显示前10个\n  const shouldTruncateDirs = isSpecialDir && directories.length > maxDirs;\n  const displayDirs = shouldTruncateDirs ? directories.slice(0, maxDirs) : directories;\n\n  displayDirs.forEach(([name, node], index) => {\n    const isLastDir = index === displayDirs.length - 1 && files.length === 0 && !shouldTruncateDirs;\n    const connector = isLastDir ? '└-' : '├-';\n    const extension = isLastDir ? '  ' : '| ';\n    const newPath = currentPath ? `${currentPath}/${name}` : name;\n\n    result += prefix + connector + name + '/\\n';\n    if (node.children && Object.keys(node.children).length > 0) {\n      result += printTree(node.children, prefix + extension, isLastDir, maxFiles, newPath);\n    }\n  });\n\n  // 如果需要截断目录，添加省略号\n  if (shouldTruncateDirs) {\n    const remainingDirCount = directories.length - maxDirs;\n    const connector = files.length > 0 ? '├-' : '└-';\n\n    result += prefix + connector + `... (${remainingDirCount} more directories)\\n`;\n  }\n\n  // 处理文件，如果超过maxFiles数量则只显示前maxFiles个并添加省略号\n  const shouldTruncateFiles = files.length > maxFiles;\n  const displayFiles = shouldTruncateFiles ? files.slice(0, maxFiles) : files;\n\n  displayFiles.forEach(([name], index) => {\n    const isLastFile = index === displayFiles.length - 1 && !shouldTruncateFiles;\n    const connector = isLastFile ? '└-' : '├-';\n\n    result += prefix + connector + name + '\\n';\n  });\n\n  // 如果需要截断文件，添加省略号\n  if (shouldTruncateFiles) {\n    const remainingFileCount = files.length - maxFiles;\n    const connector = (directories.length > 0 && !shouldTruncateDirs) || (shouldTruncateDirs && displayDirs.length > 0) ? '├-' : '└-';\n\n    result += prefix + connector + `... (${remainingFileCount} more files)\\n`;\n  }\n\n  return result;\n}\n\n/**\n * 获取树中所有文件的数量\n * @param tree - 目录树对象\n * @returns 文件数量\n */\nfunction getFileCount(tree) {\n  let count = 0;\n\n  for (const [, node] of Object.entries(tree)) {\n    if (node.type === 'file') {\n      count++;\n    } else if (node.type === 'directory' && node.children) {\n      count += getFileCount(node.children);\n    }\n  }\n\n  return count;\n}\n\n/**\n * 获取树中所有目录的数量\n * @param tree - 目录树对象\n * @returns 目录数量\n */\nfunction getDirectoryCount(tree) {\n  let count = 0;\n\n  for (const [, node] of Object.entries(tree)) {\n    if (node.type === 'directory') {\n      count++;\n      if (node.children) {\n        count += getDirectoryCount(node.children);\n      }\n    }\n  }\n\n  return count;\n}\n\n/**\n * 根据文件扩展名查找文件\n * @param tree - 目录树对象\n * @param extension - 文件扩展名\n * @returns 匹配的文件路径数组\n */\nfunction findFilesByExtension(tree, extension) {\n  const results = [];\n\n  function traverse(node, path = '') {\n    for (const [name, item] of Object.entries(node)) {\n      const currentPath = path ? `${path}/${name}` : name;\n\n      if (item.type === 'file' && name.endsWith(extension)) {\n        results.push(currentPath);\n      } else if (item.type === 'directory' && item.children) {\n        traverse(item.children, currentPath);\n      }\n    }\n  }\n\n  traverse(tree);\n  return results;\n}\n\n/**\n * 查找配置文件\n * @param tree - 目录树对象\n * @returns 配置文件路径数组\n */\nfunction findConfigFiles(tree) {\n  const configPatterns = ['.json', '.config.', '.rc', '.config'];\n  const results = [];\n\n  function traverse(node, path = '') {\n    for (const [name, item] of Object.entries(node)) {\n      const currentPath = path ? `${path}/${name}` : name;\n\n      if (item.type === 'file') {\n        const isConfig = configPatterns.some(pattern => name.includes(pattern));\n        if (isConfig) {\n          results.push(currentPath);\n        }\n      } else if (item.type === 'directory' && item.children) {\n        traverse(item.children, currentPath);\n      }\n    }\n  }\n\n  traverse(tree);\n  return results;\n}\n",
