                "content": "/**\n * AES加密解密工具类\n * AES 128位加密，AES加密模式CBC，补充方式为：PKCS5Padding\n * 分组长度不足16字节时使用最后一个字节补充，密码和向量最长16个字节，不足时补充空字符\n */\nconst CryptoJS = require('crypto-js');\n\nconst ENCODING = 'utf8';\nconst KEY_LENGTH = 16;\n\n/**\n * AES解密\n * @param {string} encryptedText - 密文（十六进制字符串）\n * @param {string} key - 密码，向量同密码\n * @returns {string|null} 解密后的明文，失败返回null\n */\nfunction decrypt(encryptedText, key) {\n    try {\n        if (!key) {\n            return null;\n        }\n\n        key = align(key);\n\n        // 使用key作为IV向量\n        const iv = key;\n\n        // 解密\n        const decrypted = CryptoJS.AES.decrypt(\n            CryptoJS.enc.Hex.parse(encryptedText).toString(CryptoJS.enc.Base64),\n            CryptoJS.enc.Utf8.parse(key),\n            {\n                iv: CryptoJS.enc.Utf8.parse(iv),\n                mode: CryptoJS.mode.CBC,\n                padding: CryptoJS.pad.Pkcs7\n            }\n        );\n\n        return decrypted.toString(CryptoJS.enc.Utf8);\n    } catch (error) {\n        console.error('AES解密失败:', error);\n        return null;\n    }\n}\n\n/**\n * AES加密\n * @param {string} plainText - 明文\n * @param {string} key - 密码，向量同密码\n * @returns {string|null} 加密后的密文（十六进制字符串），失败返回null\n */\nfunction encrypt(plainText, key) {\n    try {\n        if (!key) {\n            return null;\n        }\n\n        key = align(key);\n\n        // 使用key作为IV向量\n        const iv = key;\n\n        // 加密\n        const encrypted = CryptoJS.AES.encrypt(\n            plainText,\n            CryptoJS.enc.Utf8.parse(key),\n            {\n                iv: CryptoJS.enc.Utf8.parse(iv),\n                mode: CryptoJS.mode.CBC,\n                padding: CryptoJS.pad.Pkcs7\n            }\n        );\n\n        return encrypted.ciphertext.toString();\n    } catch (error) {\n        console.error('AES加密失败:', error);\n        return null;\n    }\n}\n\n/**\n * Buffer转十六进制字符串\n * @param {Buffer} buffer\n * @returns {string} 十六进制字符串\n */\nfunction bufferToHex(buffer) {\n    if (!buffer || buffer.length === 0) {\n        return null;\n    }\n\n    return buffer.toString('hex');\n}\n\n/**\n * 十六进制字符串转Buffer\n * @param {string} hexString\n * @returns {Buffer|null} Buffer对象\n */\nfunction hexToBuffer(hexString) {\n    if (!hexString || hexString === '') {\n        return null;\n    }\n\n    try {\n        return Buffer.from(hexString, 'hex');\n    } catch (error) {\n        console.error('十六进制字符串转Buffer失败:', error);\n        return null;\n    }\n}\n\n/**\n * 密码长度对齐\n * 密码长度小于16个字节时补充空字符，大于16个字节时只取前16个字节\n * @param {string} key - 原始密码\n * @returns {string} 对齐后的密码\n */\nfunction align(key) {\n    if (!key) {\n        return null;\n    }\n\n    const keyBuffer = Buffer.from(key, ENCODING);\n    const length = keyBuffer.length;\n\n    if (length > KEY_LENGTH) {\n        // 只取前16个字节\n        return key.slice(0, KEY_LENGTH);\n    } else if (length < KEY_LENGTH) {\n        // 补充空字符到16个字节\n        const zeroSize = KEY_LENGTH - length;\n        return key + '\\0'.repeat(zeroSize);\n    }\n\n    return key;\n}\n\n/**\n * 生成Token\n * @param {string} clientId - 客户端ID\n * @param {string} clientSecret - 客户端密钥\n * @returns {string} 生成的Token\n */\nfunction generateToken(clientId, clientSecret) {\n    const time = Date.now().toString();\n    const encryptedTime = encrypt(time, clientSecret);\n    return clientId + \"#\" + encryptedTime;\n}\n\n/**\n * 验证并解密Token\n * @param {string} token - 要验证的Token\n * @param {string} clientSecret - 客户端密钥\n * @returns {string|null} 解密后的时间戳，失败返回null\n */\nfunction validateToken(token, clientSecret) {\n    if (!token || !token.includes('#')) {\n        return null;\n    }\n\n    const parts = token.split('#');\n    if (parts.length !== 2) {\n        return null;\n    }\n\n    const encryptedTime = parts[1];\n    return decrypt(encryptedTime, clientSecret);\n}\n\n/**\n * 主函数 - 用于测试Token生成和验证\n */\nfunction main(params) {\n\n    const clientId = \"IvNPl7oVEK\";\n    const clientSecret = \"F9TvG6EHWF\";\n\n    // 生成Token\n    const token = generateToken(clientId, clientSecret);\n    console.log(\"生成的Token:\", token);\n\n    // 验证Token\n    const decryptedTime = validateToken(token, clientSecret);\n    console.log(\"解密的时间戳:\", decryptedTime);\n\n    return {\n        token,\n        decryptedTime\n    }\n}",
